<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.cesul.controllers.TripController">
   <children>
      <BorderPane prefHeight="400.0" prefWidth="682.0">
         <top>
            <HBox prefHeight="169.0" prefWidth="682.0" BorderPane.alignment="CENTER">
               <children>
                  <VBox prefHeight="119.0" prefWidth="262.0">
                     <children>
                        <Label text="Data de Inicio">
                           <VBox.margin>
                              <Insets left="10.0" top="10.0" />
                           </VBox.margin>
                        </Label>
                        <DatePicker fx:id="dataInicioPicker" prefHeight="25.0" prefWidth="157.0">
                           <VBox.margin>
                              <Insets left="10.0" top="5.0" />
                           </VBox.margin>
                        </DatePicker>
                        <Label text="Data de Fim">
                           <padding>
                              <Insets left="10.0" top="10.0" />
                           </padding>
                           <VBox.margin>
                              <Insets />
                           </VBox.margin>
                        </Label>
                        <DatePicker fx:id="dataFimPicker" prefHeight="25.0" prefWidth="157.0">
                           <VBox.margin>
                              <Insets left="10.0" top="5.0" />
                           </VBox.margin>
                        </DatePicker>
                        <Button fx:id="btnEditar" mnemonicParsing="false" onAction="#editarViagem" prefHeight="25.0" prefWidth="153.0" text="Editar viagem">
                           <VBox.margin>
                              <Insets bottom="10.0" left="30.0" top="30.0" />
                           </VBox.margin>
                        </Button>
                        <Button fx:id="btnExcluir" mnemonicParsing="false" onAction="#excluirViagem" prefHeight="25.0" prefWidth="156.0" text="Excluir Viagem">
                           <VBox.margin>
                              <Insets bottom="10.0" left="30.0" right="30.0" top="5.0" />
                           </VBox.margin>
                        </Button>
                     </children>
                  </VBox>
                  <VBox prefHeight="141.0" prefWidth="419.0">
                     <children>
                        <Label prefHeight="24.0" prefWidth="85.0" text="Digite o destino">
                           <VBox.margin>
                              <Insets left="10.0" top="10.0" />
                           </VBox.margin>
                        </Label>
                        <TextField fx:id="destinoField" prefHeight="27.0" prefWidth="401.0">
                           <VBox.margin>
                              <Insets left="10.0" right="10.0" />
                           </VBox.margin>
                        </TextField>
                        <Label text="Digite o orçamento">
                           <VBox.margin>
                              <Insets left="10.0" top="5.0" />
                           </VBox.margin>
                        </Label>
                        <TextField fx:id="orcamentoField">
                           <VBox.margin>
                              <Insets left="10.0" right="10.0" top="5.0" />
                           </VBox.margin>
                        </TextField>
                        <Button fx:id="btnAdicionar" mnemonicParsing="false" onAction="#adicionar" prefHeight="25.0" prefWidth="214.0" text="Adicionar Viagem">
                           <VBox.margin>
                              <Insets left="10.0" right="5.0" top="15.0" />
                           </VBox.margin>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </top>
         <center>
            <TableView fx:id="viagensTable" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
               <columns>
                  <TableColumn fx:id="colCidade" prefWidth="75.0" style="-fx-alignment: CENTER;" text="Destino" />
                  <TableColumn fx:id="colIni" prefWidth="75.0" style="-fx-alignment: CENTER;" text="Inicio" />
                  <TableColumn fx:id="colFim" prefWidth="75.0" style="-fx-alignment: CENTER;" text="Fim" />
                  <TableColumn fx:id="colCusto" prefWidth="75.0" style="-fx-alignment: CENTER;" text="Custo" />
               </columns>
               <BorderPane.margin>
                  <Insets left="10.0" right="10.0" top="10.0" />
               </BorderPane.margin>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </center>
         <bottom>
            <Label fx:id="lblTotal" prefHeight="17.0" prefWidth="132.0" text="TOTAL : R$ 0,00" BorderPane.alignment="CENTER">
               <BorderPane.margin>
                  <Insets bottom="10.0" top="10.0" />
               </BorderPane.margin>
            </Label>
         </bottom>
      </BorderPane>
   </children>
</AnchorPane>
