<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.cesul.controllers.TripControllerx">
   <children>
      <BorderPane prefHeight="400.0" prefWidth="600.0">
         <top>
            <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
               <children>
                  <VBox prefHeight="110.0" prefWidth="187.0">
                     <children>
                        <Label text="Data de início">
                           <VBox.margin>
                              <Insets left="10.0" top="10.0" />
                           </VBox.margin>
                        </Label>
                        <DatePicker fx:id="dataInicioPicker" prefHeight="25.0" prefWidth="155.0">
                           <VBox.margin>
                              <Insets left="10.0" top="5.0" />
                           </VBox.margin>
                        </DatePicker>
                        <Label text="Data de fim">
                           <VBox.margin>
                              <Insets left="10.0" top="5.0" />
                           </VBox.margin>
                        </Label>
                        <DatePicker fx:id="dataFimPicker" prefHeight="25.0" prefWidth="155.0">
                           <VBox.margin>
                              <Insets left="10.0" top="5.0" />
                           </VBox.margin>
                        </DatePicker>
                     </children>
                  </VBox>
                  <VBox prefHeight="110.0" prefWidth="418.0">
                     <children>
                        <Label text="Digite o destino">
                           <VBox.margin>
                              <Insets left="10.0" top="10.0" />
                           </VBox.margin>
                        </Label>
                        <TextField fx:id="destinoField" prefHeight="25.0" prefWidth="100.0">
                           <VBox.margin>
                              <Insets left="10.0" right="60.0" top="5.0" />
                           </VBox.margin>
                        </TextField>
                        <Label layoutX="20.0" layoutY="20.0" text="Digite o orçamento">
                           <VBox.margin>
                              <Insets left="10.0" top="5.0" />
                           </VBox.margin>
                        </Label>
                        <TextField fx:id="orcamentoField" prefHeight="25.0" prefWidth="100.0">
                           <VBox.margin>
                              <Insets left="10.0" right="60.0" top="5.0" />
                           </VBox.margin>
                        </TextField>
                        <Button fx:id="btnAdicionar" mnemonicParsing="false" onAction="#adicionar" prefHeight="25.0" prefWidth="200.0" text="Adicionar Viagem">
                           <VBox.margin>
                              <Insets left="10.0" right="10.0" top="5.0" />
                           </VBox.margin>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </top>
         <center>
            <TableView fx:id="viagensTable" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
              <columns>
                <TableColumn fx:id="colCidade" prefWidth="75.0" style="-fx-alignment: CENTER;" text="Destino" />
                <TableColumn fx:id="colIni" prefWidth="75.0" style="-fx-alignment: CENTER;" text="Início" />
                  <TableColumn fx:id="colFim" prefWidth="75.0" style="-fx-alignment: CENTER;" text="Fim" />
                  <TableColumn fx:id="colCusto" prefWidth="75.0" style="-fx-alignment: CENTER;" text="Custo" />
              </columns>
               <BorderPane.margin>
                  <Insets left="10.0" right="10.0" top="10.0" />
               </BorderPane.margin>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </center>
         <bottom>
            <Label fx:id="lblTotal" text="Total: R$ 0,00" BorderPane.alignment="CENTER">
               <BorderPane.margin>
                  <Insets bottom="10.0" top="10.0" />
               </BorderPane.margin>
            </Label>
         </bottom>
      </BorderPane>
   </children>
</AnchorPane>
